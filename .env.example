# Copy this file to .env and fill in real values. .env is git-ignored.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database (XAMPP MariaDB defaults: user root, empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=greenhands

# Separate database used by integration tests (its tables are emptied between tests)
TEST_DB_NAME=greenhands_test

# Seed script: credentials for the demo accounts created by `python seed.py`
SEED_ADMIN_PASSWORD=Admin#12345
SEED_VOLUNTEER_PASSWORD=Volunteer#12345
